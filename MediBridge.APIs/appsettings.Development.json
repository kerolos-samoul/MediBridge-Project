{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=MediBridge;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "MediBridge",
    "Audience": "MediBridge.ApiClients",
    "SigningKey": "Phase1DevelopmentSigningKey-ReplaceBeforeProduction-32Chars",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Identity": {
    "SeedDevelopmentAdmin": false
  },
  "RateLimiting": {
    "Policies": {
      "login": {
        "PermitLimit": 10,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      "registration": {
        "PermitLimit": 10,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      "refresh": {
        "PermitLimit": 10,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      "company-top-up": {
        "PermitLimit": 10,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      "doctor-withdrawal": {
        "PermitLimit": 10,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      "doctor-interaction": {
        "PermitLimit": 10,
        "WindowSeconds": 60,
        "QueueLimit": 0
      }
    }
  }
}
